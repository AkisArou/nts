    "Node.visit": "Checked dynamic method and receiver-preserving call; validate return shapes for Rewriter, Evaluator and Checker, preserving null/undefined and WTypeError results.",
    "Node.prepareToVerify": "Explicit return undefined replaces implicit undefined.",
    "createLiteral": "Checked dynamic formatter lookup and callable guard; same receiver and arguments.",
    "ArrayRefType.unifyImpl": "Checked ArrayRefType after the original isArrayRef guard.",
    "flattenProtocolExtends": "A separate loop reference and local union express the original ProtocolRef-to-ProtocolDecl reassignment.",
    "_inlineFunction": "Checked FuncDef after the original native/inlined early return.",
    "LexerToken.get_lineNumber": "Explicit Number performs the same conversion as the original substring index, including the original dormant five-argument token-constructor path.",
    "NameContext.add": "Checked named-node shape after the original absent-name early return.",
    "NameContext.static_underlyingThings": "Checked individual-node shape after the original Func-array branch.",
    "NameResolver._resolveTypeArguments": "Checked dynamic numeric-key read retains the original typeArgument[i] expression, including its dormant behavior.",
    "NativeTypeInstance.unifyImpl": "Checked instance after original underlying-type equality guard.",
    "parse": "Explicit Number before the original unsigned bitwise conversion; typed arrow parentheses have no effect.",
    "var:prepare": "Expose a closure that clears the cached raw standard-library AST for a fresh complete trial; its parsing and pass sequence remain.",
    "PtrType.unifyImpl": "Checked PtrType after original isPtr guard.",
    "StructType.get_isPrimitive": "Explicit Number conversions preserve the original bitwise-AND boolean/number/null/undefined coercions.",
    "synthesizeStructAccessors": "Checked implementation-data aliases preserve object identity, field writes and callback receivers.",
    "UnificationContext.find": "Checked Type/Value return shape for the original unification domain; same result object."
