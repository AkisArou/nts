{
  "//": "Also no nts.config.ts. Pure TypeScript -- but see src/index.ts: platform-sensitive with no native code, which is what makes the intersection question concrete.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./.types",
    "rootDir": "./src",
    "types": [
      "@nts/platform-android-29",
      "@nts/platform-ios-17",
      "@nts/platform-macos-14",
      "@nts/platform-linux-gnu",
      "@nts/platform-windows"
    ]
  },
  "include": [
    "src"
  ]
}
