<?xml version="1.0" encoding="utf-8"?>
<!-- **Their file.** An existing MSBuild C++ project.
     Note it references the .lib, not the .dll: the import library is what the
     linker consumes, and the .dll is what ships beside the executable. A library
     that emits only one of the two is unusable here. -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <ClCompile Include="src\main.cpp" />
  </ItemGroup>
  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>acme.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
