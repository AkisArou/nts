+// GetPlainJSDiagnosticsUnfiltered returns a plain-JS file's bind and checker
+// diagnostics without the plainJSErrors filter: everything the checker computes
+// for the file, which GetSemanticDiagnostics narrows to that list. Carried patch
+// (nts), for a consumer that applies an allowlist of its own. Nil for a file the
+// checker skips.
+func (p *Program) GetPlainJSDiagnosticsUnfiltered(ctx context.Context, sourceFile *ast.SourceFile) []*ast.Diagnostic {
+	return p.collectCheckerDiagnostics(ctx, sourceFile, func(ctx context.Context, c *checker.Checker, file *ast.SourceFile) []*ast.Diagnostic {
+		return slices.Concat(file.BindDiagnostics(), c.GetDiagnostics(ctx, file))
+	})
