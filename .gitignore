# Rust
/target

# TypeScript / pnpm
node_modules/
*.tsbuildinfo

# Build outputs
/out
/.nts

# test262, cloned whole. Not vendored: it is somebody else's repository and
# `nts-suite` skips gracefully without it.
#   git clone --depth 1 --filter=blob:none \
#     https://github.com/tc39/test262.git third_party/test262
#
# It used to be a sparse checkout of three directories, and that was the wrong
# saving: 280MB against an answer to "can we test this?" that was too often
# "the files are not here". `harness/` and `INTERPRETING.md` matter as much as
# the tests -- the frontmatter is what makes the suite filterable at all. See
# `docs/conformance/test262.md`.
/third_party/test262

# Are We Fast Yet, cloned sparsely. Not vendored, for the same reason: it is
# somebody else's repository, and the TypeScript port in `benches/awfy` is ours.
# What the clone is for is the *fidelity gate* -- running their `.js` and our
# `.ts` on node and comparing -- and the reference C++ column.
#   git clone --depth 1 --filter=blob:none --sparse \
#     https://github.com/smarr/are-we-fast-yet third_party/are-we-fast-yet
#   cd third_party/are-we-fast-yet && git sparse-checkout set \
#     benchmarks/JavaScript 'benchmarks/C++' docs
/third_party/are-we-fast-yet

# Node.js, cloned sparsely for the Node compatibility profile. Not vendored,
# for the same reason as the others: it is somebody else's repository, and what
# we want from it is `lib/`, which is 15MB of the 1.5GB.
#   git clone --depth 1 --filter=blob:none --sparse --branch v24.20.0 \
#     https://github.com/nodejs/node.git third_party/node
#   cd third_party/node && git sparse-checkout set lib
/third_party/node

# Deno, cloned sparsely to measure its extension JS and its Rust crates against
# the Node question. Not vendored, for the same reason as the others.
#   git clone --depth 1 --filter=blob:none --sparse \
#     https://github.com/denoland/deno.git third_party/deno
#   cd third_party/deno && git sparse-checkout set ext core
/third_party/deno

