+test('command indices share cached lexical strings and keep shadowed and cyclic names unknown',()=>{
+  const api=new API(),source=`const executable='git',alias=(executable as string),args=['status'];
+run(alias,args);function local(executable:string){run(executable,args);}
+const cycle=other,other=cycle;run(cycle,[]);run(makeCommand(),[]);
+const vector=[alias,...args];
+probe({command:'discarded',command:alias,args});probe({command:alias,command:makeCommand(),args});
+const data={nested:{command:'cargo',args:['test']},command:alias,args};`;
+  const lease=api.createSourceFile('commands.ts',source);
+  try{
+    const facts=new SourceFacts('commands.ts',source,lease.sourceFile);
+    const calls=facts.stringCommands('call');assert.equal(facts.stringCommands('call'),calls);
+    assert.equal(calls.map(row=>row.command).join(','),'git');
+    assert.equal(facts.stringCommands('argv').map(row=>row.command).join(','),'status,git,test');
+    assert.equal(facts.stringCommands('probe').map(row=>row.command).join(','),'git,git,cargo');
+    for(const row of facts.stringCommands('probe'))assert.ok(row.args);
+  }finally{lease.dispose();api.close();}
+});
