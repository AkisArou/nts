  "observer": {
    "legacy_raising_suffix": "$raises"
  },
  "name_escape": {
    "ascii_literal": "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-",
    "escaped_non_ascii": [
      8204,
      8205
    ]
  }
