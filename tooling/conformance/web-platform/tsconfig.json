{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "rootDir": "../../..",
    "outDir": "./node_modules/.tsbuild/host",
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
