{
  "//": "A composite project, so apps can reference it and tsc can build the graph incrementally.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./.types",
    "rootDir": "./src",
    "types": [
      "@nts/platform-android-29",
      "@nts/platform-ios-17"
    ]
  },
  "include": [
    "src"
  ]
}
