{
  "version": 1,
  "scope": "JVM member names only; generated class names and class-file paths keep their existing authority.",
  "prefix": "¢nts$",
  "roles": [
    {
      "rust": "PRINT",
      "stem": "print",
      "key": "none"
    },
    {
      "rust": "NAME",
      "stem": "name",
      "key": "none"
    },
    {
      "rust": "CLASS_NAME",
      "stem": "class",
      "key": "none"
    },
    {
      "rust": "PRESENCE",
      "stem": "presence",
      "key": "none"
    },
    {
      "rust": "PRESENCE_MEMBER",
      "stem": "presenceGet",
      "key": "none"
    },
    {
      "rust": "ENV_MEMBER",
      "stem": "env",
      "key": "none"
    },
    {
      "rust": "BIND_LANE",
      "stem": "bindLane",
      "key": "none"
    },
    {
      "rust": "LANE",
      "stem": "lane",
      "key": "none"
    },
    {
      "rust": "RESUME",
      "stem": "resume",
      "key": "none"
    },
    {
      "rust": "ERASED_CALL",
      "stem": "call",
      "key": "none"
    },
    {
      "rust": "RAISING_CALL",
      "stem": "callRaises",
      "key": "none"
    },
    {
      "rust": "MODULE_INIT",
      "stem": "moduleInit",
      "key": "none"
    },
    {
      "rust": "INTERFACE_HELD",
      "stem": "interface",
      "key": "none"
    },
    {
      "rust": "storage_field",
      "stem": "field",
      "key": "name",
      "suffix": "payload"
    },
    {
      "rust": "defined",
      "stem": "field",
      "key": "name",
      "suffix": "defined"
    },
    {
      "rust": "global",
      "stem": "global",
      "key": "name"
    },
    {
      "rust": "body",
      "stem": "body",
      "key": "name"
    },
    {
      "rust": "guarded_dispatch",
      "stem": "dispatch",
      "key": "name"
    },
    {
      "rust": "face_field",
      "stem": "field",
      "key": "name",
      "suffix": "accessor"
    },
    {
      "rust": "template",
      "stem": "template",
      "key": "name"
    },
    {
      "rust": "closure",
      "stem": "closure",
      "key": "name"
    },
    {
      "rust": "erased_closure",
      "stem": "erasedClosure",
      "key": "name"
    },
    {
      "rust": "RAISING_PAIRS",
      "stem": "raisingPairs",
      "key": "none"
    }
  ],
  "java_templates": [
