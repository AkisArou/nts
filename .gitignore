# Rust
/target
# A second target directory, so that three sessions sharing one checkout do not
# serialise on one `cargo` lock or rebuild each other's artifacts. Ignored for a
# reason worth stating: with `git status` now something all three of us read
# after a commit went wrong, 6,793 untracked files in it is not a tidiness
# complaint -- it is the signal being buried.
/target-jvm
# A third, for the same reason. This one belongs to the build-system lane, whose
# changes are in `tooling/cli` and want a baseline binary and a changed one side
# by side -- which is one rebuild of the shared directory each way, and the
# other two sessions paying for both.
/target-config

# Chromium is an opt-in source-build lane. Its src tree is a pinned submodule;
# gclient/depot_tools caches and generated dependency state are reproducible.
/third_party/chromium/depot_tools/
/third_party/chromium/.gclient_*
/third_party/chromium/.gcs_entries
/third_party/chromium/.cipd*
/third_party/chromium/_bad_scm/
/third_party/chromium/.gsutil/

# TypeScript / pnpm
node_modules
*.tsbuildinfo

# Build outputs
/out
/.nts

# The complete test262 corpus, including harness and metadata, is acquired at
# tooling/bootstrap/test262.pin in test262.d/<pin>, then linked per tree.
# Legacy directories remain in place for older trees; nothing shared moves.
/third_party/test262
/third_party/test262.d

# TypeScript's tests-only sparse population is acquired at typescript.pin in
# typescript.d/<pin>, verified against the native checker and linked per tree.
# Bootstrap uses the same corpus owner and retains nonempty legacy directories.
/third_party/typescript
/third_party/typescript.d

# Are We Fast Yet's C++ and Java references, at tooling/bootstrap/awfy.pin.
# Prepared and verified by: node tooling/bootstrap/awfy.ts --acquire
# Pin-addressed sparse checkouts live under are-we-fast-yet.d/<pin>. Each
# tree's linker acquires and selects its own pin. The legacy directory stays
# in place for older trees and running benchmarks; no existing clone moves.
/third_party/are-we-fast-yet
/third_party/are-we-fast-yet.d

# Node.js, cloned sparsely for the Node compatibility profile. Not vendored,
# for the same reason as the others: it is somebody else's repository, and what
# we want from it is `lib/`, which is 15MB of the 1.5GB.
#   git clone --depth 1 --filter=blob:none --sparse --branch v26.13.0 \
#     https://github.com/nodejs/node.git third_party/node
#   cd third_party/node && git sparse-checkout set lib
/third_party/node
/third_party/node-source
/third_party/node-inputs

# Deno, cloned sparsely to measure its extension JS and its Rust crates against
# the Node question. Not vendored, for the same reason as the others.
#   git clone --depth 1 --filter=blob:none --sparse \
#     https://github.com/denoland/deno.git third_party/deno
#   cd third_party/deno && git sparse-checkout set ext core
/third_party/deno

# Generated by `nts deps`: recovered dependency source and the config that
# points at it. Both are derived from `node_modules` and rebuilt on demand.
.nts/
tsconfig.nts.json
# Written by `nts build` before 2026-10-07 beside a project that used a
# platform's packages. Generated roots now go straight to the in-process
# frontend and are never written; these are ignored for trees that still
# hold one.
tsconfig.gir.json
tsconfig.objc.json
tsconfig.windows.json

# Declaration output from `tsc -b tests/workspace/tsconfig.solution.json`.
# Composite projects must emit, so the fixture's packages emit declarations into
# `.types/`. It is not here because it was overlooked: until the baseUrl and
# platform-surface fixes the solution build failed on every project, so nothing
# was ever written and there was nothing to ignore.
.types/

# The per-fixture directory is the oracle authority. A comparison-private
# legacy view and atomic-publication staging are derived and untracked.
/results/oracle-counts.json
/results/.oracle-record-*/
